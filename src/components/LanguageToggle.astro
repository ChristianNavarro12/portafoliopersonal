---
import { Languages } from '@lucide/astro';
---

<div class="relative inline-flex items-center">
  <Languages class="w-4 h-4 absolute left-3 pointer-events-none opacity-70" />
  <select
    id="language-switcher"
    aria-label="Cambiar idioma"
    class="appearance-none bg-transparent border border-black/10 dark:border-white/10 rounded-full pl-9 pr-3 py-2 text-sm font-medium cursor-pointer hover:bg-black/5 dark:hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500"
  >
    <option value="es" class="bg-bg-light text-text-light dark:bg-bg-dark dark:text-text-dark">ES</option>
    <option value="en" class="bg-bg-light text-text-light dark:bg-bg-dark dark:text-text-dark">EN</option>
  </select>
</div>

<script>
  import i18next from 'i18next';
  import es from '../locales/es.json';
  import en from '../locales/en.json';

  function updateContent() {
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (!key) return;

      if (key.startsWith('[')) {
        const match = key.match(/\[(.+?)\](.+)/);
        if (!match) return;
        const [, attr, i18nKey] = match;
        el.setAttribute(attr, i18next.t(i18nKey));
      } else {
        el.innerHTML = i18next.t(key);
      }
    });
  }

  const savedLang = localStorage.getItem('lang') || 'es';

  i18next.init(
    {
      lng: savedLang,
      fallbackLng: 'es',
      resources: {
        es: { translation: es },
        en: { translation: en },
      },
    },
    () => {
      updateContent();
      document.dispatchEvent(new CustomEvent('langchange', { detail: { lang: savedLang } }));
    }
  );

  const select = document.getElementById('language-switcher') as HTMLSelectElement;
  select.value = savedLang;

  select.addEventListener('change', (e) => {
    const lang = (e.target as HTMLSelectElement).value;
    i18next.changeLanguage(lang, () => {
      updateContent();
      localStorage.setItem('lang', lang);
      document.documentElement.lang = lang;
      document.dispatchEvent(new CustomEvent('langchange', { detail: { lang } }));
    });
  });

  // La expongo global por si Contact.astro necesita re-traducir el botón del form dinámicamente
  (window as any).updateContent = updateContent;
</script>