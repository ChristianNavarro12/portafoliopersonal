---
interface Props {
  eyebrowKey?: string;
  eyebrow?: string;
  titleKey: string;
  title: string;
}
const { eyebrowKey, eyebrow, titleKey, title } = Astro.props;
---
<div class="text-center max-w-2xl mx-auto mb-16" data-aos="fade-up">
  {eyebrow && (
    <p data-i18n={eyebrowKey} class="text-brand-500 font-semibold text-sm uppercase tracking-wide mb-3">
      {eyebrow}
    </p>
  )}
  <h2 data-i18n={titleKey} class="font-display text-3xl md:text-4xl font-bold">
    {title}
  </h2>
</div>