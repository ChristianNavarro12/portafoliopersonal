---
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';

// Nombra aquí los archivos; guárdalos en public/images/projects/ con el mismo nombre.
const projects = [
  {
    image: '/images/projects/api-ecommerce.png',
    titleKey: 'p_t1',
    title: 'API Rest — E-commerce',
    descKey: 'p_tp1',
    desc: 'API REST mini ecommerce...',
    href: 'https://ecommerce-api-gpqo.onrender.com/swagger-ui.html',
  },
  {
    image: '/images/projects/api-student.png',
    titleKey: 'p_t2',
    title: 'API Rest — Estudiantes',
    descKey: 'p_tp2',
    desc: 'API REST para gestión de estudiantes...',
    href: 'https://api-estudiantes-wy99.onrender.com/api-docs/',
  },
  {
    image: '/images/projects/api-todo.png',
    titleKey: 'p_t3',
    title: 'API Rest — Productos',
    descKey: 'p_tp3',
    desc: 'API REST para gestión de productos...',
    href: 'https://api-productos-x7wm.onrender.com/api-docs/',
  },
  {
    image: '/images/projects/crud.png',
    titleKey: 'p_t4',
    title: 'CRUD',
    descKey: 'p_tp4',
    desc: 'Aplicación CRUD conectada a una API de estudiantes...',
    href: 'https://crud-estudiantes-tau.vercel.app/',
  },
  {
    image: '/images/projects/todolist.png',
    titleKey: 'p_t5',
    title: 'TODO List',
    descKey: 'p_tp5',
    desc: 'Aplicación tipo TODO List conectada a una API de productos...',
    href: 'https://todo-productos.vercel.app/',
  },
  {
    image: '/images/projects/ecommerce.png',
    titleKey: 'p_t6',
    title: 'Ecommerce',
    descKey: 'p_tp6',
    desc: 'Mini e-commerce con sistema de login y registro funcional...',
    href: 'https://mini-ecommerce-two-psi.vercel.app/',
  },
];
---

<section id="projects" class="pt-6 md:pt-10 pb-24 md:pb-32 px-6 md:px-10 lg:px-16">
  <div class="max-w-7xl mx-auto">
    <SectionHeading eyebrowKey="projects_eyebrow" eyebrow="Mi trabajo" titleKey="projects" title="Proyectos" />

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, i) => (
        <div data-aos="fade-up" data-aos-delay={(i % 3) * 150} class="h-full">
          <ProjectCard {...project} />
        </div>
      ))}
    </div>
  </div>
</section>