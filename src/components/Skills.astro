---
import SectionHeading from './SectionHeading.astro';

const skills = [
  { name: 'HTML5', file: 'html5.svg' },
  { name: 'CSS3', file: 'css3.svg' },
  { name: 'JavaScript', file: 'javascript.svg' },
  { name: 'TypeScript', file: 'typescript.svg' },
  { name: 'React', file: 'react.svg' },
  { name: 'Node.js', file: 'nodejs.svg' },
  { name: 'Express', file: 'express.svg', invertOnDark: true },
  { name: 'Prisma', file: 'prisma.svg', invertOnDark: true },
  { name: 'PostgreSQL', file: 'postgresql.svg' },
  { name: 'PHP', file: 'php.svg', invertOnDark: true },
  { name: 'Laravel', file: 'laravel.svg' },
  { name: 'Tailwind CSS', file: 'tailwindcss.svg' },
  { name: 'Git', file: 'git.svg' },
  { name: 'GitHub', file: 'github.svg', invertOnDark: true },
];
---

<section id="skills" class="pt-6 md:pt-10 pb-24 md:pb-32 px-6 md:px-10 lg:px-16">
  <div class="max-w-7xl mx-auto">
    <SectionHeading eyebrowKey="skills_eyebrow" eyebrow="Mi stack" titleKey="skills" title="Habilidades" />

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5">
      {skills.map(({ name, file, invertOnDark }, i) => (
        <div
          data-aos="fade-up"
          data-aos-delay={(i % 5) * 100}
          class="group flex flex-col items-center justify-center gap-3 bg-white dark:bg-white/5 border border-black/5 dark:border-white/10 rounded-2xl py-8 px-4 hover:-translate-y-1.5 hover:shadow-lg hover:shadow-brand-500/10 hover:border-brand-500/30 transition-all duration-300"
        >
          <img
            src={`/images/skills/${file}`}
            alt={name}
            loading="lazy"
            class:list={[
              'w-12 h-12 object-contain grayscale-30 group-hover:grayscale-0 transition-all duration-300',
              invertOnDark && 'dark:invert',
            ]}
          />
          <h3 class="text-sm font-medium opacity-80">{name}</h3>
        </div>
      ))}
    </div>
  </div>
</section>