---
import { Mail } from '@lucide/astro';
import GithubIcon from './icons/GithubIcon.astro';
import LinkedinIcon from './icons/LinkedinIcon.astro';

---

<footer
  data-aos="fade-up"
  class="border-t border-black/5 dark:border-white/10 pt-16 pb-10 px-6 md:px-10 lg:px-16"
>
  <div class="max-w-7xl mx-auto flex flex-col items-center gap-8">

    <a href="#home" class="font-display text-2xl font-bold tracking-tight">
      Christian<span class="text-brand-500">.</span>
    </a>

    <div class="flex gap-4">
      <a href="https://github.com/ChristianNavarro12" target="_blank" rel="noopener noreferrer" aria-label="GitHub"
        class="w-11 h-11 flex items-center justify-center rounded-full border-2 border-brand-500 hover:bg-brand-500 hover:text-white transition-all hover:-translate-y-1">
        <GithubIcon class="w-5 h-5" />
      </a>
      <a href="https://www.linkedin.com/in/christian-yahir-navarro-chan-055476262/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
        class="w-11 h-11 flex items-center justify-center rounded-full border-2 border-brand-500 hover:bg-brand-500 hover:text-white transition-all hover:-translate-y-1">
        <LinkedinIcon class="w-5 h-5" />
      </a>
      <a href="mailto:ejemplo@gmail.com" aria-label="Email"
        class="w-11 h-11 flex items-center justify-center rounded-full border-2 border-brand-500 hover:bg-brand-500 hover:text-white transition-all hover:-translate-y-1">
        <Mail class="w-5 h-5" />
      </a>
    </div>

    <nav class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm font-medium">
      <a href="#home" data-i18n="home" class="opacity-70 hover:opacity-100 hover:text-brand-500 transition">Home</a>
      <a href="#services" data-i18n="services" class="opacity-70 hover:opacity-100 hover:text-brand-500 transition">Servicios</a>
      <a href="#skills" data-i18n="skills" class="opacity-70 hover:opacity-100 hover:text-brand-500 transition">Habilidades</a>
      <a href="#projects" data-i18n="projects" class="opacity-70 hover:opacity-100 hover:text-brand-500 transition">Proyectos</a>
      <a href="#contact" data-i18n="contact" class="opacity-70 hover:opacity-100 hover:text-brand-500 transition">Contacto</a>
    </nav>

    <p data-i18n="footerp" class="text-xs opacity-50 text-center">
      Christian © 2026 | Todos los derechos reservados.
    </p>
  </div>
</footer>