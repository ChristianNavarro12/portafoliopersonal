---
import { Code, Server, Smartphone } from '@lucide/astro';
import SectionHeading from './SectionHeading.astro';

const services = [
  {
    icon: Code,
    titleKey: 'ser1',
    title: 'Desarrollador Frontend',
    descKey: 'serp1',
    desc: 'Desarrollo interfaces web modernas, claras y funcionales...',
  },
  {
    icon: Server,
    titleKey: 'ser2',
    title: 'Desarrollador Backend',
    descKey: 'serp2',
    desc: 'Desarrollo la lógica y el funcionamiento interno de aplicaciones web...',
  },
  {
    icon: Smartphone,
    titleKey: 'ser3',
    title: 'Desarrollador Móvil',
    descKey: 'serp3',
    desc: 'Desarrollo aplicaciones móviles enfocadas en rendimiento y usabilidad...',
  },
];
---

<section id="services" class="pt-6 md:pt-10 pb-24 md:pb-32 px-6 md:px-10 lg:px-16">
  <div class="max-w-7xl mx-auto">
    <SectionHeading eyebrowKey="services_eyebrow" eyebrow="Lo que hago" titleKey="services" title="Servicios" />

    <div class="grid gap-8 md:grid-cols-3">
      {services.map(({ icon: Icon, titleKey, title, descKey, desc }, i) => (
        <div
          data-aos="fade-up"
          data-aos-delay={i * 150}
          class="group bg-white dark:bg-white/5 border border-black/5 dark:border-white/10 rounded-3xl p-10 flex flex-col items-center text-center hover:-translate-y-2 hover:shadow-xl hover:shadow-brand-500/10 transition-all duration-300"
        >
          <div class="w-16 h-16 flex items-center justify-center rounded-2xl bg-brand-500/10 text-brand-500 mb-6 group-hover:bg-brand-500 group-hover:text-white transition-colors duration-300">
            <Icon class="w-8 h-8" />
          </div>
          <h4 data-i18n={titleKey} class="font-display text-xl font-bold mb-3">{title}</h4>
          <p data-i18n={descKey} class="opacity-70 leading-relaxed text-sm">{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>